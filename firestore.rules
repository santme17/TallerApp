rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/books/{bookId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validBook() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'id', 'title', 'author', 'pages',
            'isRead', 'updatedAt', 'isDeleted'
          ])
          && d.id == bookId
          && d.title is string && d.title.size() > 0
          && d.title.size() <= 100
          && d.author is string && d.author.size() <= 100
          && d.pages is int && d.pages >= 0
          && d.isRead is bool
          && d.updatedAt is int
          && d.isDeleted is bool;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validBook();
      allow delete: if isOwner();
    }
  }
}
